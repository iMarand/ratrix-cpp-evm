# ==============================================================
#  Ratrix EVM C++ - ignore rules
# ==============================================================

# --- Secrets / local config -----------------------------------
# .env is #include-d as C++ (holds _PRIVATE_KEY_ / _ADDRESS_). Keep it local.
.env
*.env
Bundler/.env
.env.*
!.env.example

# --- Compiled binaries ----------------------------------------
*.exe
*.out
*.app
threads-choose
threads-choose.exe

# --- Object / intermediate build files ------------------------
*.o
*.obj
*.a
*.lib
*.d
*.gch
*.pch
/tmp/
debug_*

# --- Shared libraries (shipped by MSYS2/MinGW, not source) -----
*.dll
*.so
*.so.*
*.dylib

# --- Program output / scan data -------------------------------
# Generated wallets, matches and full scan logs - can be huge and are secret.
*.data
*.scan.*
*.csv
*.cvs
yasmarang.found.data
yasmarang.scan.csv
yasmarang.unchecked.data
found.txt
brute.data
bruteRandom.data
bruteRandomPrivate.data

# --- Wallets & secrets (never commit) -------------------------
# Encrypted wallet files are per-user; plaintext legacy wallets are sensitive.
*.rtxwallet
legacy/old-wallets-PLAINTEXT/
DOTENV_*

# --- CMake build dir ------------------------------------------
/build-dev/
/build-cli/
/build/CMakeCache.txt
/build/CMakeFiles/

# --- Node -----------------------------------------------------
node_modules/
Node/node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json

# --- Editor / OS ----------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/c_cpp_properties.json
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# --- Keep large data headers, ignore accidental copies --------
*.log
*.tmp

# --- Release output (portable folder + installers; never source) ----
/dist/

# --- Wallet data (plaintext/legacy wallet exports are sensitive) -----
*_DATA.json
/bin/

# --- Quarantined legacy scanner code (NOT part of the wallet product) ---
# The brute-force / collision-scanner half is kept locally only and is not
# distributed with the wallet. Source stays on disk; git does not track it.
/legacy/

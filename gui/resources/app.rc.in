// Windows resources for RatrixWallet.exe: icon (Explorer, taskbar) and file
// version info. Configured by CMake so the icon path is absolute.
#include <winver.h>

IDI_ICON1 ICON "@RATRIX_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Ratrix"
            VALUE "FileDescription",  "Ratrix Wallet"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "RatrixWallet"
            VALUE "OriginalFilename", "RatrixWallet.exe"
            VALUE "ProductName",      "Ratrix Wallet"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
